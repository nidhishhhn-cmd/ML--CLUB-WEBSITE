# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force specific binary types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.mp4 binary
*.webm binary
*.webp binary
*.woff binary
*.woff2 binary

# Windows-specific files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
