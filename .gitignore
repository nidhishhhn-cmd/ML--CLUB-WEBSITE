# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Production build outputs
dist/
dist-ssr/
build/
out/
.parcel-cache/
*.local

# Portable binaries & local installation tools
node-bin/

# Large video & archive files (exceeds GitHub 100MB file limit)
*.mov
*.avi
*.mkv
*.webm
*.zip
*.tar
*.tar.gz
hero-video.mp4.mp4
public/hero-video.mp4

# Allow optimized club intro video (<100MB)
!images/hero-video*

# Allow essential deployment & sync scripts
!push_to_github.bat
!copy_photos.bat
!copy_principal_photo.bat
!build-static.js
!copy-video.js

# Temporary diagnostic logs & files
install-log.txt
node-ver.txt
npm-err.txt
npm-out.txt
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Nested clone directory
ML---CLUB-WEBSITE/
ML--CLUB-WEBSITE/

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Editor & OS files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.tmp

.vercel
.env*
