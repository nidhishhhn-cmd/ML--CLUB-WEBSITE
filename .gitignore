# ==============================================================================
# ML Club Website (.gitignore)
# Optimized for GitHub, GitHub Pages, Vercel, Netlify & Vite Deployments
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Production build outputs
dist/
dist-ssr/
build/
out/
.parcel-cache/
*.local

# Portable binaries & local installation cache
node-bin/

# Temporary diagnostic logs & files
install-log.txt
node-ver.txt
npm-err.txt
npm-out.txt
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Nested clone directory (prevents accidental recursive clones)
ML---CLUB-WEBSITE/
ML--CLUB-WEBSITE/

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Editor & OS files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.tmp

# Batch & PowerShell scripts (ignore temporary scripts, allow repository deployment helpers)
*.bat
*.ps1
!push_github.bat
!push_github.ps1
!push_main.bat
!push_main.ps1
!push_branch1.bat
!push_branch1.ps1

# Large video & archive files exceeding GitHub 100MB file limit
*.mov
*.avi
*.mkv
*.webm
*.zip
*.tar
*.tar.gz

# Production deployment media assets (<100MB) explicitly whitelisted
!hero-video.mp4.mp4
!public/hero-video.mp4
!images/hero-video.mp4.MP4
!images/hero-video.mp4.mp4
!images/hero-video.mp4
